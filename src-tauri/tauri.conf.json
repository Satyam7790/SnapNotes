{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quickspace",
  "version": "0.1.0",
  "identifier": "com.quickspace.notes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Quickspace", "width": 1120, "height": 760, "minWidth": 800, "minHeight": 600, "center": true, "visible": true, "backgroundColor": "#f7f7f5" },
      { "label": "capture", "title": "Quickspace Capture", "width": 390, "height": 300, "minWidth": 360, "minHeight": 260, "center": true, "visible": false, "alwaysOnTop": true, "decorations": false, "transparent": true, "skipTaskbar": true }
    ],
    "security": { "assetProtocol": { "enable": true, "scope": ["$APPDATA/assets/**"] }, "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Keep the context behind your screenshots",
    "fileAssociations": [{ "ext": ["png", "jpg", "jpeg", "webp"], "name": "Screenshot image", "role": "Viewer", "rank": "None" }]
  },
  "plugins": {
    "fs": { "requireLiteralLeadingDot": false }
  }
}
